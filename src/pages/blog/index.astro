---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Blog" description="Notes on dbt, SQL, Snowflake and data visualisation.">
  <div class="wrap page-head">
    <p class="eyebrow">Blog</p>
    <h1>Food for Data</h1>
    <p class="lead">A free tasting of what I've learned about data.</p>
  </div>
  <section style="padding-top:1rem"><div class="wrap">
    <ul class="posts">
      {posts.map((p) => (
        <li><a href={p.data.permalink}>
          <time datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</time>
          <span class="t">{p.data.title}</span>
          <span class="cat">{p.data.category}</span>
        </a></li>
      ))}
    </ul>
  </div></section>
</Base>
