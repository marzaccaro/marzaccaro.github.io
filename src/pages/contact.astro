---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import Email from '../components/Email.astro';
---
<Base title="Contact" description="Get in touch about dbt and analytics engineering work for your team.">
  <div class="wrap page-head">
    <p class="eyebrow">Contact</p>
    <h1>Let's talk</h1>
    <p class="lead">Tell me a bit about your data stack and what you're trying to fix. I reply within two working days.</p>
    <div class="actions"><a class="btn" href={site.booking} rel="noopener">Book a 15-minute call</a></div>
  </div>
  <section style="padding-top:1rem">
    <div class="wrap grid" style="max-width:44rem;margin-left:0">
      <div class="card"><h3>Email</h3><p><Email /></p></div>
      <div class="card"><h3>LinkedIn</h3><p><a href={site.linkedin} rel="me noopener">martinazaccaron</a></p></div>
      <div class="card"><h3>GitHub</h3><p><a href={site.github} rel="me noopener">marzaccaro</a></p></div>
    </div>
  </section>
</Base>
